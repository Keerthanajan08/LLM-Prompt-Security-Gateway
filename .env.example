# Copy to .env. Defaults run fully locally: mock LLM, in-memory cache.

# --- LLM: mock | openai | groq | gemini -------------------------------------
LLM_PROVIDER=mock
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Force one model for every request (otherwise clients' `model` field is used):
# LLM_MODEL=
# Any OpenAI-compatible server (OpenRouter, Ollama, vLLM...), used with LLM_PROVIDER=openai:
# LLM_BASE_URL=http://localhost:11434/v1

# --- Detection ---------------------------------------------------------------
# Rule packs: global (secrets, payment data, contact details) + regional: us, uk, eu, in
RULE_PACKS=global,us
# block | redact | log_only   (log_only = flag but don't enforce; good for rollout)
ON_LEAK_ACTION=block
# What to do when the LLM's *answer* contains sensitive data: redact | block | log_only
ON_RESPONSE_LEAK_ACTION=redact
ENABLE_INJECTION_DETECTION=true
# Calibrated on evals/dataset.jsonl (dev split); see evals/results.md
SEMANTIC_LEAK_THRESHOLD=0.66
INJECTION_SIMILARITY_THRESHOLD=0.67

# --- Embeddings --------------------------------------------------------------
# sentence-transformers (real model) | hashing (lexical only; tests/offline)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Limits & hygiene ----------------------------------------------------------
MAX_PROMPT_CHARS=20000
MASK_MATCHES_IN_RESPONSE=true
EXPOSE_CORPUS_SNIPPETS=false
CORS_ORIGINS=*

# --- Cache (unset = in-memory) -----------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=10000
